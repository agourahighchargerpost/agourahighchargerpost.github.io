{%- comment -%} Pass `crumbs` as "Label|/url/;Label|/url/" and `last` (label) + `lastUrl`. {%- endcomment -%}
<div class="digital-newspaper-breadcrumb-wrap">
    <div role="navigation" aria-label="Breadcrumbs" class="breadcrumb-trail breadcrumbs" itemprop="breadcrumb"><ul class="trail-items" itemscope itemtype="http://schema.org/BreadcrumbList"><li itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem" class="trail-item trail-begin"><a href="/" rel="home" itemprop="item"><span itemprop="name">Home</span></a><meta itemprop="position" content="1" /></li>
    {%- assign position = 1 -%}
    {%- if crumbs != blank %}{% assign items = crumbs | split: ";" %}{% for item in items %}{% assign parts = item | split: "|" %}{% assign position = position | plus: 1 %}<li itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem" class="trail-item"><a href="{{ parts[1] }}" itemprop="item"><span itemprop="name">{{ parts[0] }}</span></a><meta itemprop="position" content="{{ position }}" /></li>{% endfor %}{% endif -%}
    {%- assign position = position | plus: 1 -%}
    <li itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem" class="trail-item trail-end"><span data-url="{{ lastUrl }}" itemprop="item"><span itemprop="name">{{ last }}</span></span><meta itemprop="position" content="{{ position }}" /></li></ul></div>
</div>
